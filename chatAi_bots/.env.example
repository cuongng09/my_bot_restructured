# ── Bắt buộc ─────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_SEC=120
OLLAMA_RETRY_ATTEMPTS=2

# ── Quyền truy cập ───────────────────────────────────────────────────────────
# Để trống = mọi người dùng được (không khuyến nghị cho production)
ALLOWED_USERS=
# Để trống = không ai dùng được lệnh admin (/shutdown, /reboot, dashboard admin)
ADMIN_USER_IDS=

# ── Hành vi chung ────────────────────────────────────────────────────────────
MAX_HISTORY=25
RATE_LIMIT_SEC=3
MAX_UPLOAD_MB=15
REQUIRE_MENTION_IN_GROUPS=true
LONG_TERM_MEMORY_EVERY_N_TURNS=10
STREAM_EDIT_INTERVAL=0.7

# ── Đường dẫn dữ liệu ────────────────────────────────────────────────────────
DB_PATH=data/bot_data.db
LOG_FILE=logs/bot.log

# ── OCR ──────────────────────────────────────────────────────────────────────
# Windows ví dụ: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux thường chỉ cần: tesseract
TESSERACT_CMD=tesseract
OCR_LANG=eng+vie

# ── Voice (tùy chọn) ─────────────────────────────────────────────────────────
GROQ_API_KEY=

FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE=int8

PIPER_VOICE_PATHS=nu:./voices/vi_VN-vais1000-medium.onnx,nam:./voices/vi_VN-25hours_single-low.onnx
PIPER_DEFAULT_VOICE=nu

# ── 🆕 Trí nhớ dài hạn nâng cao: TencentDB Agent Memory (tencent_memory.py) ───
# Bật để thay thế cơ chế "tự tóm tắt profile_summary bằng Ollama" bằng bộ nhớ đa
# tầng L0(hội thoại)→L1(sự thật nguyên tử)→L2(kịch bản)→L3(hồ sơ) do Gateway
# mã nguồn mở https://github.com/TencentCloud/TencentDB-Agent-Memory tự trích xuất
# và cập nhật ở nền. Xem hướng dẫn triển khai Gateway ở UPGRADE_GUIDE.md.
MEMORY_TENCENTDB_ENABLED=false
MEMORY_TENCENTDB_ENDPOINT=http://127.0.0.1:8420
MEMORY_TENCENTDB_API_KEY=
MEMORY_TENCENTDB_SERVICE_ID=default
MEMORY_TENCENTDB_AGENT_ID=telegram-bot
MEMORY_TENCENTDB_TEAM_ID=default
MEMORY_TENCENTDB_TIMEOUT_SEC=8
MEMORY_TENCENTDB_RECALL_LIMIT=5
