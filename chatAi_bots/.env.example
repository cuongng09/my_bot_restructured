# ── Bắt buộc ─────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=

# ── Kết nối Telegram API ─────────────────────────────────────────────────────
# Timeout dài hơn mặc định (5s) — tăng lên nếu mạng tới api.telegram.org chậm.
TELEGRAM_CONNECT_TIMEOUT=15
TELEGRAM_READ_TIMEOUT=30

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=120
OLLAMA_RETRY_ATTEMPTS=2

# ── Quyền truy cập ───────────────────────────────────────────────────────────
# Để trống = mọi người dùng được (không khuyến nghị cho production)
ALLOWED_USERS=
# Để trống = không ai dùng được lệnh admin (/shutdown, /reboot, dashboard admin)
ADMIN_USER_IDS=

# ── Hành vi chung ────────────────────────────────────────────────────────────
MAX_HISTORY=25
RATE_LIMIT_SEC=3
MAX_UPLOAD_MB=15
REQUIRE_MENTION_IN_GROUPS=true
LONG_TERM_MEMORY_EVERY_N_TURNS=10
STREAM_EDIT_INTERVAL=0.7

# ── Đường dẫn dữ liệu ────────────────────────────────────────────────────────
DB_PATH=data/bot_data.db
LOG_FILE=logs/bot.log

# ── OCR ──────────────────────────────────────────────────────────────────────
# Windows ví dụ: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux thường chỉ cần: tesseract
TESSERACT_CMD=tesseract
OCR_LANG=eng+vie

# ── Voice (tùy chọn) — Groq Whisper dùng cho engine STT "groq" (/stt groq) ────
GROQ_API_KEY=

FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE=int8

PIPER_VOICE_PATHS=nu:./voices/vi_VN-vais1000-medium.onnx,nam:./voices/vi_VN-25hours_single-low.onnx
PIPER_DEFAULT_VOICE=nu

# ── 🏮 Trạm Điều Khiển Web (webapp/) — dashboard quản trị trên trình duyệt ────
# Chạy: python -m webapp.main   (hoặc: uvicorn webapp.main:app --host 0.0.0.0 --port 8080)
# WEBAPP_HOST=0.0.0.0 nghĩa là "lắng nghe trên mọi card mạng" — đây là địa chỉ để SERVER
# lắng nghe, KHÔNG phải địa chỉ để mở trên trình duyệt. Trên trình duyệt luôn truy cập
# bằng http://localhost:8080 hoặc http://127.0.0.1:8080 (gõ 0.0.0.0:8080 sẽ không vào được).
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Để trống = trang KHÔNG có xác thực (chỉ nên để trống khi chạy sau VPN/reverse-proxy
# riêng). Đặt một chuỗi bất kỳ để bật màn hình đăng nhập bằng token.
WEBAPP_TOKEN=
# URL công khai để hiện nút "🌐 Mở Trạm Điều Khiển Web" trong menu Hệ thống của /ui.
# Để trống thì ẩn nút này. Ví dụ: http://192.168.1.10:8080 hoặc https://bot.example.com
WEBAPP_PUBLIC_URL=

