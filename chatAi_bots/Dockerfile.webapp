# =====================================================================
#  Dockerfile.webapp — Trạm Điều Khiển Web (FastAPI Dashboard)
#  Build siêu nhẹ & nhanh, chỉ cài đặt thư viện cần thiết cho dashboard.
# =====================================================================

FROM python:3.11-slim

WORKDIR /app

# Biến môi trường cơ bản cho Python
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    RUNNING_WEBAPP=1

# Cài đặt các thư viện cần thiết cho WebApp
RUN pip install --no-cache-dir \
    fastapi>=0.110 \
    uvicorn[standard]>=0.29 \
    aiosqlite>=0.20 \
    httpx>=0.27 \
    psutil>=5.9 \
    python-dotenv>=1.0

# Copy mã nguồn WebApp, file config và module skills
COPY config.py /app/config.py
COPY bot_logger.py /app/bot_logger.py
COPY skills /app/skills
COPY webapp /app/webapp

# Tạo sẵn thư mục mount dữ liệu và nhật ký
RUN mkdir -p /app/data /app/logs

EXPOSE 8080

CMD ["python", "-m", "webapp.main"]
