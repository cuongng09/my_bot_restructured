# =====================================================================
#  .gitignore — my_bot_restructured
# =====================================================================

# ── Môi trường & Bí mật ──────────────────────────────────────────────
.env
.env.*
.env.local
searxng/.env
!.env.example

# ── Môi trường ảo Python ─────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python Cache & Build Artifacts ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
src/*.egg-info/
src/**/__pycache__/

# ── Nhật ký thực thi (Logs) ──────────────────────────────────────────
logs/*.log*
*.log
*.log.*
bot.log*
!logs/.gitkeep

# ── Cơ sở dữ liệu & Tệp runtime ──────────────────────────────────────
data/*.db
data/*.db-*
data/*.sqlite*
data/reports/*
data/pdf_reports/*
pdf_output/*
exports/*
!data/.gitkeep
!data/**/.gitkeep

# ── Model & Dự án con phụ trợ ─────────────────────────────────────────
voices/*.onnx
voices/*.onnx.json
models/
voicebox/
!voices/.gitkeep
!fonts/.gitkeep

# ── Test & Coverage ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Cấu hình Docker cục bộ ───────────────────────────────────────────
docker-compose.override.yml

# ── IDE & Trình soạn thảo ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Hệ điều hành ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db